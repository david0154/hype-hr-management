<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="32dp">

    <!-- Employee Photo (standard ImageView, no CircleImageView dependency needed) -->
    <ImageView
        android:id="@+id/ivEmpPhoto"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="48dp"
        android:src="@drawable/ic_person_placeholder"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_circle_photo"
        android:clipToOutline="true"
        android:contentDescription="Employee photo" />

    <!-- Employee Name -->
    <TextView
        android:id="@+id/tvEmpName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Welcome Back"
        android:textColor="#1A1A2E"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter your PIN to continue"
        android:textColor="#777777"
        android:textSize="14sp" />

    <!-- PIN Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:hint="Enter PIN"
        app:hintTextColor="#555555"
        app:boxStrokeColor="#6C63FF"
        app:passwordToggleEnabled="true"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:textColor="#1A1A2E"
            android:textSize="24sp"
            android:gravity="center"
            android:letterSpacing="0.4" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Unlock Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnEnterPin"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Unlock"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold"
        app:backgroundTint="#6C63FF"
        app:cornerRadius="12dp" />

    <!-- Fallback to password login -->
    <TextView
        android:id="@+id/tvLoginWithPassword"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Use email &amp; password instead"
        android:textColor="#6C63FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:padding="8dp" />

</LinearLayout>
