<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0d1b2a">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1a2740"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="#FFFFFF" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Salary Slip"
            android:textColor="#F0C040"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingStart="8dp" />
    </LinearLayout>

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:layout_above="@id/bottomBar"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Progress -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="visible" />

            <!-- Salary Slip Card -->
            <LinearLayout
                android:id="@+id/slipCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <!-- Company Header -->
                <TextView
                    android:id="@+id/tvCompany"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="HYPE HR MANAGEMENT"
                    android:textColor="#1a2740"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSlipTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="#F77F00"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingBottom="8dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="10dp"/>

                <!-- Employee Info -->
                <TextView android:id="@+id/tvEmpName" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#111111"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvEmpId" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#555555" android:textSize="12sp" />
                <TextView android:id="@+id/tvDesig" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:textColor="#555555"
                    android:textSize="12sp" android:paddingBottom="10dp" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="10dp"/>

                <!-- Attendance Section -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="ATTENDANCE" android:textColor="#1a2740"
                    android:textSize="11sp" android:textStyle="bold"
                    android:background="#F5F5F5" android:padding="6dp" android:layout_marginBottom="6dp"/>

                <include layout="@layout/row_salary_item" android:id="@+id/rowPresent" />
                <include layout="@layout/row_salary_item" android:id="@+id/rowHalf" />
                <include layout="@layout/row_salary_item" android:id="@+id/rowAbsent" />
                <include layout="@layout/row_salary_item" android:id="@+id/rowOtDays" />

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="10dp"/>

                <!-- Earnings Section -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="EARNINGS" android:textColor="#1a2740"
                    android:textSize="11sp" android:textStyle="bold"
                    android:background="#F5F5F5" android:padding="6dp" android:layout_marginBottom="6dp"/>

                <include layout="@layout/row_salary_item" android:id="@+id/rowBaseSalary" />
                <include layout="@layout/row_salary_item" android:id="@+id/rowEarned" />
                <include layout="@layout/row_salary_item" android:id="@+id/rowOtPay" />

                <!-- Gross -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="#1a2740" android:padding="10dp" android:layout_marginTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="GROSS PAY"
                        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"/>
                    <TextView android:id="@+id/tvGross" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#F0C040"
                        android:textStyle="bold" android:textSize="15sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginVertical="10dp"/>

                <!-- Deductions -->
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="DEDUCTIONS" android:textColor="#1a2740"
                    android:textSize="11sp" android:textStyle="bold"
                    android:background="#F5F5F5" android:padding="6dp" android:layout_marginBottom="6dp"/>

                <include layout="@layout/row_salary_item" android:id="@+id/rowAdvance" />

                <!-- Net Pay -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="#27ae60" android:padding="12dp" android:layout_marginTop="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="NET PAY"
                        android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="15sp"/>
                    <TextView android:id="@+id/tvNetPay" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#FFFFFF"
                        android:textStyle="bold" android:textSize="18sp"/>
                </LinearLayout>

                <!-- Payment Mode -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:padding="8dp" android:layout_marginTop="6dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:text="Payment Mode"
                        android:textColor="#777777" android:textSize="12sp"/>
                    <TextView android:id="@+id/tvPayMode" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:textColor="#1a2740"
                        android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginTop="10dp"/>

                <TextView android:id="@+id/tvGeneratedOn"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#AAAAAA" android:textSize="10sp"
                    android:gravity="center" android:paddingTop="8dp" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#1a2740"
        android:orientation="horizontal"
        android:padding="10dp">

        <Button
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📤 Share"
            android:backgroundTint="#F77F00"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="📷 Save"
            android:backgroundTint="#1e6f9f"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Close"
            android:backgroundTint="#555555"
            android:textColor="#FFFFFF" />
    </LinearLayout>

</RelativeLayout>
