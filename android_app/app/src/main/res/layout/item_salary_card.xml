<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/colorSurface"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="January 2026"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/colorText"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹ 0.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorSuccess"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvFinalSalary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Final: ₹ 0.00"
            android:textSize="13sp"
            android:textColor="@color/colorTextMuted"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tvBonusStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bonus: —"
            android:textSize="12sp"
            android:textColor="@color/colorTextMuted"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvSlipStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏳ Generating..."
            android:textSize="12sp"
            android:textColor="@color/colorWarning"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownloadSlip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="View Slip"
            android:textSize="12sp"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
