<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HypeHR">

        <activity android:name=".ui.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.HypeHR.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".ui.LoginActivity" android:exported="false" />
        <activity android:name=".ui.login.LoginActivity" android:exported="false" />
        <activity android:name=".ui.DashboardActivity" android:exported="false" />
        <activity android:name=".ui.AttendanceActivity" android:exported="false" />
        <activity android:name=".ui.AttendanceHistoryActivity" android:exported="false" />
        <activity android:name=".ui.SalaryActivity" android:exported="false" />
        <activity android:name=".ui.SalarySlipViewerActivity" android:exported="false" />
        <activity android:name=".ui.IdCardActivity" android:exported="false" />
        <activity android:name=".ui.HolidayActivity" android:exported="false" />
        <activity android:name=".ui.SecurityLoginActivity" android:exported="false" />
        <activity android:name=".ui.SecurityDashboardActivity" android:exported="false" />
        <activity android:name=".ui.SecurityScanActivity" android:exported="false" />
        <activity android:name=".ui.PinEntryActivity" android:exported="false" />
        <activity android:name=".ui.PinLoginActivity" android:exported="false" />
        <activity android:name=".ui.PinSetupActivity" android:exported="false" />

    </application>
</manifest>
