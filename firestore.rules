rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Pre-login username lookup needs public read
    match /employees/{empId} {
      allow read:  if true;
      allow write: if false;

      match /{subcollection}/{docId} {
        allow read:  if isAuth();
        allow write: if isAuth();
      }
    }

    match /attendance_logs/{logId} {
      allow read, write: if isAuth();
    }

    match /sessions/{sessionId} {
      allow read, write: if isAuth();
    }

    // salary_slips — used by Android SalaryActivity
    // simple auth check; employee_id filtering done client-side
    match /salary_slips/{slipId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    // salary — legacy collection used by admin_app / PHP backend
    match /salary/{slipId} {
      allow read:  if isAuth() &&
                   slipId.matches(request.auth.uid + '_.*');
      allow write: if false;
    }

    match /advance_logs/{logId} {
      allow read:  if isAuth();
      allow write: if false;
    }

    match /admin_users/{userId} {
      allow read, write: if false;
    }

    match /settings/{doc} {
      allow read:  if isAuth();
      allow write: if false;
    }
  }
}
